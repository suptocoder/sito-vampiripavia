# Copy this file to `.env` and fill in your own values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
# `.env` is gitignored — never commit real secrets.

# ---- Secrets (pick long random strings; do NOT reuse the demo values) ----

# Lets the sidecar register the roster users on the homeserver. Any long random string,
# but it must match on both services (compose wires that for you from this one value).
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-to-a-long-random-string

# Fallback Matrix password for roster entries that don't set their own `password`.
# Prefer per-player passwords in roster.json; this covers any that are left blank.
MATRIX_DEMO_PASSWORD=change-me-shared-password

# Lets you reset RPG state without the staff login (POST /seed?admin_secret=...).
VP_ADMIN_SECRET=change-me-admin-secret

# ---- URLs / identity ----

# Matrix server name -> user IDs look like @marco:<this>. Once players have registered you
# must NOT change it (their accounts are tied to it). "local" works for a closed server;
# use your domain if you prefer @marco:elysium.example.org.
MATRIX_SERVER_NAME=local

# PUBLIC https URL where players' browsers reach Synapse. This is the Synapse domain you
# put behind your reverse proxy / TLS. Example: https://synapse.yourdomain.tld
VP_PUBLIC_SYNAPSE_URL=https://synapse.yourdomain.tld

# ---- Ports (host side; usually left as-is behind a reverse proxy) ----
SYNAPSE_PORT=8008
SIDECAR_PORT=8787

# ---- Optional ----
# VP_AUSPEX_DICE=1   # legacy randomized Auspex contest instead of deterministic reveal
